{
  "name": "fluncle",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@ai-sdk/react": "4.0.20",
      "@base-ui/react": "~1.6.0",
      "@libsql/client": "~0.17.4",
      "@openrouter/ai-sdk-provider": "~3.0.0",
      "@orpc/client": "1.14.7",
      "@orpc/contract": "1.14.7",
      "@orpc/openapi": "1.14.7",
      "@orpc/openapi-client": "1.14.7",
      "@orpc/server": "1.14.7",
      "@orpc/tanstack-query": "1.14.7",
      "@orpc/zod": "1.14.7",
      "@phosphor-icons/react": "~2.1.10",
      "@remotion/bundler": "4.0.499",
      "@remotion/captions": "4.0.499",
      "@remotion/cli": "4.0.499",
      "@remotion/fonts": "4.0.499",
      "@remotion/renderer": "4.0.499",
      "@tanstack/react-query": "~5.101.4",
      "@types/bun": "~1.3.14",
      "@types/node": "~26.1.1",
      "@types/react": "~19.2.17",
      "@types/react-dom": "~19.2.3",
      "ai": "~7.0.37",
      "class-variance-authority": "~0.7.1",
      "cmdk": "~1.1.1",
      "cnfast": "~0.0.8",
      "commander": "~15.0.0",
      "dotenv": "~17.4.2",
      "drizzle-kit": "~0.31.10",
      "drizzle-orm": "~0.45.2",
      "react": "~19.2.8",
      "react-dom": "~19.2.8",
      "remotion": "4.0.499",
      "sonner": "~2.0.7",
      "typescript": "~7.0.2",
      "zod": "4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit --audit-level=high --ignore=GHSA-f88m-g3jw-g9cj --ignore=GHSA-xcpc-8h2w-3j85 --ignore=GHSA-w3rx-r6r6-pgpr --ignore=GHSA-5p2g-fcmc-qvqq",
    "build": "turbo run build",
    "check": "bun run lint && bun run format:check && bun run go:check && bun run typecheck && bun run test && bun run test:scripts && bun run build",
    "check:fix": "bun run lint:fix && bun run format",
    "deploy:gate": "bun run format:check && bun run lint && bun run go:check && bun run typecheck && bun run test && bun run test:scripts",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "go:check": "turbo run lint format:check --filter=@fluncle/ssh --filter=@fluncle/dns",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "skills:install": "bun run scripts/install-skills.ts",
    "stories:build": "bun scripts/build-user-story-matrix.ts",
    "social:preview": "bun run --cwd packages/video social:preview",
    "test": "turbo run test",
    "test:scripts": "bun test --cwd scripts && bun test --cwd .claude/hooks && bun test --cwd docs/agents/hermes/scripts && bun test --cwd packages/skills/fluncle-track-enrichment/scripts && bun test --cwd packages/skills/fluncle-box-restore/scripts && bun test --cwd packages/skills/fluncle-catalogue-prune/scripts",
    "prepare": "command -v husky > /dev/null 2>&1 && husky || true",
    "typecheck": "turbo run typecheck",
    "doctor": "react-doctor"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "husky": "~9.1.7",
    "lint-staged": "~17.3.0",
    "oxfmt": "~0.64.0",
    "oxlint": "~1.79.0",
    "oxlint-tsgolint": "~7.0.2001",
    "react-doctor": "~0.9.1",
    "turbo": "~2.10.6",
    "typescript": "catalog:"
  },
  "overrides": {
    "nanoid@^3.0.0": "3.3.18",
    "undici": "7.29.0"
  },
  "lint-staged": {
    "*": [
      "oxfmt --write --ignore-path .prettierignore --no-error-on-unmatched-pattern"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "// overrides": {
    "nanoid@^3.0.0": "Drop when every parent chain resolves to nanoid 3.3.18 or newer on its own.",
    "undici": "Drop when Miniflare's exact undici dependency is 7.29.0 or newer."
  },
  "patchedDependencies": {
    "@remotion/bundler@4.0.499": "patches/@remotion%2Fbundler@4.0.499.patch",
    "@modelcontextprotocol/sdk@1.30.0": "patches/@modelcontextprotocol%2Fsdk@1.30.0.patch"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ]
}
