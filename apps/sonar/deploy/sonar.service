[Unit]
Description=Fluncle sonar — in-memory vector-similarity engine
Documentation=https://github.com/mauricekleine/fluncle/tree/main/apps/sonar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sonar
Group=sonar
# Secrets + config (Turso read creds, SONAR_SECRET, port, TLS paths). Installed 0600 root:root.
EnvironmentFile=/etc/sonar.env
ExecStart=/opt/sonar/sonar
Restart=on-failure
RestartSec=3
# Bind 443 as a non-root user (Cloudflare proxies to the origin on 443).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Hardening — the service only needs to read its binary + cert dir and reach the network.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadOnlyPaths=/opt/sonar /etc/sonar
# The whole corpus lives in RAM; cap it so a runaway never threatens the SSH terminal on the box.
MemoryMax=2G

[Install]
WantedBy=multi-user.target
