[Unit]
Description=Fluncle sonar — in-memory vector-similarity engine
Documentation=https://github.com/mauricekleine/fluncle/tree/main/apps/sonar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sonar
Group=sonar
# Secrets + config (replica sync credentials, artifact API agent token,
# SONAR_SECRET, state-path env names, port, TLS paths). Installed 0600 root:root.
EnvironmentFile=/etc/sonar.env
ExecStart=/opt/sonar/sonar
Restart=on-failure
RestartSec=3
# Bind 443 as a non-root user (Cloudflare proxies to the origin on 443).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# libSQL replica + consumer checkpoint live below the systemd-managed state directory.
# The EnvironmentFile points SONAR_REPLICA_PATH and SONAR_STATE_PATH into it.
StateDirectory=fluncle-sonar
StateDirectoryMode=0700
UMask=0077
# Hardening: the service only needs its state directory, binary/certs, and network.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadOnlyPaths=/opt/sonar /etc/sonar
# The whole corpus lives in RAM; cap it so a runaway never threatens the SSH terminal on the box.
MemoryMax=2G

[Install]
WantedBy=multi-user.target
