{
  "name": "@fluncle/web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "bench:context-distil": "bun run scripts/bench-context-distil.ts",
    "build": "bun run scripts/copy-sprites.ts && NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "capture:distil-corpus": "bun run scripts/capture-distil-corpus.ts",
    "db:backfill-due-work": "bun run scripts/backfill-due-work.ts",
    "db:backfill": "bun run scripts/backfill-plan-recording-mixtape.ts && bun run scripts/backfill-labels.ts && bun run scripts/backfill-label-aliases.ts && bun run scripts/backfill-artist-social-reviews.ts && bun run scripts/backfill-remixer-roles.ts && bun run scripts/backfill-is-catalogue.ts && bun run scripts/backfill-hub-counts.ts && bun run scripts/backfill-track-embeddings.ts && bun run scripts/backfill-has-embedding.ts && bun run scripts/backfill-has-isrc.ts && bun run scripts/backfill-identity-ledger.ts && bun run scripts/backfill-track-duplicate-keys.ts",
    "db:performance": "bun run scripts/db-performance/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:telemetry": "drizzle-kit generate --config drizzle-telemetry.config.ts",
    "db:migrate": "drizzle-kit migrate && bun run scripts/ensure-search-index.ts",
    "db:migrate:telemetry": "bun run scripts/migrate-telemetry.ts",
    "db:pull-prod": "bun run scripts/db-pull-prod.ts",
    "db:refresh-dev": "bun run scripts/db-refresh.ts",
    "db:restore-drill": "bun run scripts/restore-drill.ts",
    "db:secrets": "bun run scripts/render-dev-vars.ts",
    "deploy": "bun run build && wrangler deploy",
    "deploy:cf": "bun run db:migrate && bun run db:backfill && wrangler deploy && bun scripts/purge-edge-cache.ts && bun run db:migrate:telemetry",
    "dev": "bun run scripts/dev.ts",
    "dev:vite": "bun run scripts/copy-sprites.ts && vite dev --host 127.0.0.1 --port 3000",
    "lint": "oxlint",
    "postinstall": "fumadocs-mdx",
    "preview": "bun run build && wrangler dev",
    "probe": "bun run scripts/post-deploy-probe.ts",
    "pretypecheck": "fumadocs-mdx",
    "r2:cors": "wrangler r2 bucket cors set fluncle-videos --file r2-cors.json",
    "smoke:browser": "bun run smoke:shell && bun run smoke:queue && bun run smoke:touch",
    "smoke:held-note": "SEED=1 bun tests/browser/held-note-smoke.ts",
    "smoke:queue": "SEED=1 bun tests/browser/queue-smoke.ts",
    "smoke:routine": "bun run scripts/smoke-routine.ts",
    "smoke:shell": "bun tests/browser/shell-smoke.ts",
    "smoke:touch": "bun tests/browser/admin-touch-smoke.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test": "node ../../node_modules/vitest/vitest.mjs run --coverage"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@base-ui/react": "catalog:",
    "@better-auth/expo": "1.6.26",
    "@breezystack/lamejs": "~1.2.7",
    "@dnd-kit/core": "~6.3.1",
    "@dnd-kit/sortable": "~10.0.0",
    "@dnd-kit/utilities": "~3.2.2",
    "@fluncle/contracts": "workspace:*",
    "@fluncle/registry": "workspace:*",
    "@fluncle/sprites": "workspace:*",
    "@fluncle/tokens": "workspace:*",
    "@fluncle/ui": "workspace:*",
    "@libsql/client": "catalog:",
    "@openrouter/ai-sdk-provider": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "@resvg/resvg-wasm": "~2.6.2",
    "@scalar/api-reference-react": "~0.9.65",
    "@sentry/cloudflare": "~10.70.0",
    "@sentry/core": "~10.70.0",
    "@sentry/tanstackstart-react": "~10.70.0",
    "@tailwindcss/vite": "~4.3.3",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.34",
    "ai": "catalog:",
    "aws4fetch": "~1.0.20",
    "better-auth": "1.6.26",
    "class-variance-authority": "catalog:",
    "cmdk": "catalog:",
    "cnfast": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "fumadocs-core": "~16.14.5",
    "fumadocs-mdx": "~15.3.0",
    "fumadocs-ui": "~16.14.5",
    "jpeg-js": "~0.4.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "simple-icons": "~16.28.0",
    "sonner": "catalog:",
    "tailwindcss": "~4.3.3",
    "workers-og": "~0.0.27",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "~1.53.1",
    "@fluncle/test-support": "workspace:*",
    "@huggingface/transformers": "~4.2.0",
    "@playwright/test": "~1.62.1",
    "@sentry/vite-plugin": "~5.4.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "~6.1.0",
    "@vitest/coverage-v8": "~4.1.11",
    "drizzle-kit": "catalog:",
    "oxc-parser": "~0.146.0",
    "playwright-core": "~1.62.1",
    "shadcn": "~4.18.0",
    "typescript": "catalog:",
    "vite": "~8.2.2",
    "vitest": "~4.1.11",
    "wrangler": "~4.125.0"
  }
}
