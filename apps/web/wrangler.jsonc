{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fluncle-web",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "assets": {
    "run_worker_first": ["/llms.txt"]
  },
  "placement": {
    "region": "aws:eu-west-1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "VITE_FLUNCLE_SPOTIFY_PLAYLIST_URL": "https://open.spotify.com/playlist/1m5LADqpLjiBERdtqrIiL0?si=054d3c6cbcf14a36",
    "VITE_FLUNCLE_TELEGRAM_URL": "https://t.me/fluncle",
    "R2_ACCOUNT_ID": "0651fd3b33d9e0b2fe72a5f13e5cf65d",
    "CF_CACHE_PURGE_ZONE_ID": "93b403e3d6ed70d10cdd2890c557376f",
    "CARTESIA_VOICE_ID": "ca8c023f-1901-40f7-be8c-faafd7a58139",
    "OPENROUTER_SEARCH_MODEL": "openai/gpt-5.6-luna",
    "OPENROUTER_REASONING_EFFORT": "low",
    "OPENROUTER_CONTEXT_MODEL": "openai/gpt-5.6-luna",
    "OPENROUTER_CONTEXT_EFFORT": "medium"
  },
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "fluncle-videos"
    },
    {
      "binding": "SOURCE_AUDIO",
      "bucket_name": "fluncle-source-audio"
    }
  ]
}
