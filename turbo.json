{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "100%",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "10GB",
  "globalPassThroughEnv": ["FLEET_CPU_CAP", "TURBO_CONCURRENCY"],
  "globalDependencies": ["tsconfig.json", "bunfig.toml", "patches/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_PROJECT_WORKER",
        "WORKERS_CI_COMMIT_SHA"
      ],
      "outputs": ["dist/**", ".cloudflare/output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": false
    },
    "format:check": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["FLUNCLE_VITEST_COVERAGE"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@fluncle/tooling#typecheck": {
      "cache": false,
      "dependsOn": []
    },
    "@fluncle/web#typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/agents/hermes/scripts/**"]
    },
    "@fluncle/web#test": {
      "dependsOn": ["^build"],
      "env": ["FLUNCLE_VITEST_COVERAGE"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/agents/hermes/scripts/**"]
    }
  },
  "ui": "tui"
}
