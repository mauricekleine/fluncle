{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json", "bunfig.toml", "patches/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_PROJECT_WORKER",
        "WORKERS_CI_COMMIT_SHA"
      ],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": false
    },
    "format:check": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  },
  "ui": "tui"
}
