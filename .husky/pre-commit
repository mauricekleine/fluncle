# Agent worktrees share the repo's git but NOT node_modules, so the tools lint-staged
# spawns (oxlint, oxfmt — bare commands resolved from node_modules/.bin) ENOENT there
# and kill the commit; the historical workaround was `--no-verify`, which then skipped
# the hook in checkouts where it DOES work (and shipped a sort-keys violation to main
# on 2026-07-12). So: skip lint-staged LOUDLY when the tools are absent — the CI gate
# is the correctness net — and always run it where they exist.
if [ -x "node_modules/.bin/oxlint" ]; then
  bunx lint-staged
else
  echo "husky: node_modules/.bin/oxlint missing (fresh worktree?) — skipping lint-staged; CI runs the full gate."
fi

# Scoped skills auto-sync — keep the committed skill copies in lockstep with their
# canonical sources under packages/skills/**. `skills:install` is a CODEGEN step: it
# regenerates files OUTSIDE the staged set (.agents/skills/**, .claude/skills/**,
# skills-lock.json). We run it as a dedicated step AFTER `lint-staged` — not as a
# lint-staged glob — because:
#   1. lint-staged only re-stages the files IT matched; a task that writes OTHER files
#      leaves the regenerated copies unstaged (silently out of the commit). A plain
#      `git add` of the three output paths is the reliable way to fold them in.
#   2. Running after lint-staged keeps the generated copies byte-identical to what
#      `skills:install` produces — lint-staged never gets a chance to reformat them —
#      so the selected Skills lane in Quality Checks stays green.
# It is a no-op (no npx, no cost) unless a packages/skills/** file is actually staged,
# so a normal commit pays nothing.
# Caveat: this regenerates from the WORKING TREE, so a partially-staged skill edit can
# stage output reflecting the unstaged source. The CI drift guard is the correctness
# net that catches that on the PR (it regenerates from the committed tree and fails on
# any diff).
if git diff --cached --name-only | grep -q '^packages/skills/'; then
  echo "husky: skill source staged — syncing committed skill copies (bun run skills:install)…"
  bun run skills:install || {
    echo "husky: skills:install failed — aborting commit. Fix it, or re-commit with --no-verify."
    exit 1
  }
  git add .agents/skills .claude/skills skills-lock.json
fi

# Edit hooks start affected leaves in the background. A commit is the explicit join point: the
# fingerprinted result must match the complete worktree, so an edit made while checks were running
# cannot accidentally reuse a stale pass.
if [ -x "node_modules/.bin/oxlint" ]; then
  # Husky/lint-staged may prepend the relative `node_modules/.bin`. The shell-integrity
  # guard deliberately rejects relative PATH entries, so make that known entry absolute
  # before the join (and avoid `bun run`, which would add it again).
  preflight_path="$(printf '%s' "$PATH" | sed "s#^node_modules/.bin:#$(pwd -P)/node_modules/.bin:#; s#:node_modules/.bin:#:$(pwd -P)/node_modules/.bin:#g; s#:node_modules/.bin\$#:$(pwd -P)/node_modules/.bin#")"
  PATH="$preflight_path" node scripts/quality/preflight.mjs join
fi
