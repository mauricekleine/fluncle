  "ignorePatterns": [
    ".agents/skills/**",
    ".claude/skills/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/.output/**",
    "**/build/**",
    "**/.turbo/**",
    "apps/raycast/raycast-env.d.ts",
    "**/*.gen.ts",
    "apps/web/src/routeTree.gen.ts",
    "apps/web/worker-configuration.d.ts",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "no-comments",
      "specifier": "./tools/oxlint/no-comments/index.ts"
    }
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "plugins": ["eslint", "import", "jsx-a11y", "oxc", "react", "typescript", "unicorn", "vitest"],
  // jsx-a11y is a DOM ruleset: React Native's a11y model (accessibilityLabel, no <output>/
  // <fieldset> elements, autoFocus as standard form UX) makes its findings noise there, so
  // mobile opts back out of the rules that fire on RN primitives. (An override can't drop a
  // whole plugin, so the DOM-shaped rules are named; extend this list if a new one fires.)
  "overrides": [
    {
      "files": ["tools/oxlint/no-comments/**"],
      "rules": {
        "eslint/sort-keys": "off",
        "import/consistent-type-specifier-style": "off"
