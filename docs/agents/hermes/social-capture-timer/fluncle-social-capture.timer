[Unit]
Description=fluncle-social-capture timer — trigger the social-URL-capture sweep every 10m on the rave-02 host

[Timer]
# Per-firing jitter dissolves timer-phase alignment: mass timer restarts, including a pin-watch
# rebake's quiesce/restore, can re-align every sweep to fire
# the same second; the synchronized write bursts convoy on libSQL's single writer).
# Re-rolled each firing, so no restart can ever re-align the roster.
RandomizedDelaySec=90
# First tick shortly after boot (staggered at 6min), then every 10m — the social-capture
# cadence. Persistent catches up a tick missed across a box
# reboot. Idempotent (the Worker no-ops once every pending post has a captured URL), so a
# deferred tick just grabs the URLs on the next cycle.
OnBootSec=6min
OnUnitActiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target
