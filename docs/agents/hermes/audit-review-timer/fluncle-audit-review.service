[Unit]
Description=fluncle-audit-review — 05:00 reviewer for the nightly audit PR (fix-small-and-merge, or comment + hold)
Documentation=https://github.com/mauricekleine/fluncle/blob/main/docs/agents/hermes/audit-timer/README.md
Wants=network-online.target docker.service
After=network-online.target docker.service
# If this unit dies before writing its own /status marker (OOM, missing binary, a crash
# before the sweep catch runs), the healthcheck prober never sees a failure. This catch-all
# posts a minimal Discord alert; %n is this unit's full name.
OnFailure=fluncle-sweep-failure@%n.service

[Service]
Type=oneshot
# Root drives Docker; the WORK runs as unprivileged hermes. Baked at /opt/hermes-scripts (Unit A);
# self-writes its /status marker (cron-output.sh). Merging lands on main → a production deploy,
# gated on green required checks (the reviewer confirms via `gh pr checks`).
ExecStart=/usr/bin/docker exec -u hermes -e HOME=/opt/data/home hermes bash /opt/hermes-scripts/audit-review-sweep.sh
# A BACKSTOP, NOT THE BUDGET — same reasoning as the auditor's unit: this kills the host-side
# `docker exec` client only, so the real budget lives in the script (`agent-pass.sh`). The
# reviewer's own pass is bounded by AUDIT_REVIEW_PASS_BUDGET_SECS, which must stay strictly under
# this ceiling plus its kill grace and the driver's checkout/merge time.
TimeoutStartSec=3000
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
