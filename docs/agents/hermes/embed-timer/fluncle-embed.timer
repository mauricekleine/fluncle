[Unit]
Description=fluncle-embed timer — trigger the audio-embedding sweep every 5m on the rave-02 host (not the Hermes gateway)

[Timer]
# Per-firing jitter dissolves timer-phase alignment: mass timer restarts, including a pin-watch
# rebake's quiesce/restore, can re-align every sweep to fire
# the same second; the synchronized write bursts convoy on libSQL's single writer).
# Re-rolled each firing, so no restart can ever re-align the roster.
RandomizedDelaySec=90
# First tick shortly after boot, then every 5m — the embed cadence. Persistent catches up a
# missed window (box reboot) on the next wake. The queue is idempotent (an embedded finding
# leaves the `embedding_json IS NULL` queue) and key-gated + newest-first, so a skipped tick
# just defers the batch (FLUNCLE_EMBED_BATCH); unlike a Hermes cron, the host scheduler is never busy
# with long sweeps, so the tick fires on time even while a multi-minute full-song embed runs.
OnBootSec=3min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
