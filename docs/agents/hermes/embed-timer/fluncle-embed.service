[Unit]
Description=fluncle-embed — rave-02 host trigger for the audio-embedding sweep (decoupled from the latency-sensitive gateway cron runner)
Documentation=https://github.com/mauricekleine/fluncle/blob/main/docs/agents/hermes/embed-timer/README.md
Wants=network-online.target docker.service
After=network-online.target docker.service
# If this unit dies before writing its own /status marker (OOM, missing binary, a crash
# before the sweep catch runs), the healthcheck prober never sees a failure. This catch-all
# posts a minimal Discord alert; %n is this unit's full name.
OnFailure=fluncle-sweep-failure@%n.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/fluncle/database-admission.env
# The host unit runs as root (to drive the Docker daemon); `docker exec -u hermes` runs the
# in-container embed WORK as the UNPRIVILEGED hermes user (hermes owns the 0600 secrets file
# the .sh sources). The .sh/.ts/.py trio is BAKED into the image at /opt/hermes-scripts/
# (Unit A — it auto-updates from main via pin-watch, no /opt/data/scripts copy); this host
# unit only TRIGGERS it. A windowed full-song MuQ forward is MINUTES-SCALE (each ~30s window
# is a full forward; a 5-min song is ~10 windows), so it must NOT ride the one serial Hermes
# cron runner (a ~300s global budget) where an embed tick would starve the latency-sensitive
# 5-min enrich/context/note sweeps — the same reason capture, the healthcheck prober, and the
# pin-watch rebuild are host timers.
# Database admission is phase-scoped inside the orchestrator: the worklist read and each vector
# write take their own short lease through database-admission-runner.sh, while the source-audio
# fetch and MuQ inference hold none. The admission environment rides the `docker exec` so it
# reaches the runner inside the container. Install this unit only after the image carries the
# phased script (the README's rollout order).
ExecStart=/usr/bin/docker exec -e DATABASE_ADMISSION_FAIL_CLOSED -e DATABASE_ADMISSION_POLL_SECS=2 -u hermes -e HOME=/opt/data/home -e FLUNCLE_EMBED_BATCH=3 hermes bash /opt/hermes-scripts/embed-sweep.sh
# The batch cap and this timeout are ONE decision, re-derived whenever FLUNCLE_EMBED_BATCH moves:
#
#   TimeoutStartSec = 120 (the worklist window's admission ceiling, paid ONCE per tick)
#                   + batch × 300 (fetch + windowed full-song forward per track)
#                   + batch × 120 (each result's own write-window admission ceiling)
#                   + 30 (wrapper, CLI, and cost-row overhead)
#
# At batch 3: 120 + 900 + 360 + 30 = 1410.
#
# The 300s per-track term is deliberately generous. The ledger's slowest single-track tick runs
# ~294s wall, and that number already carries a whole torch import + MuQ model load plus its
# admission wait — costs a batch pays ONCE for the manifest, not once per track. So 300s per
# MARGINAL track over-counts, which is the right direction for a kill that wastes a finished
# forward. (Typical ticks sit far below it: p90 ~230s, median ~174s for a whole single-track tick.)
TimeoutStartSec=1410
# Modest hardening for a root docker-driving oneshot.
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
