[Unit]
Description=fluncle-capture timer — trigger the full-song capture sweep every 5m on the rave-02 host

[Timer]
# Per-firing jitter dissolves timer-phase alignment: mass timer restarts, including a pin-watch
# rebake's quiesce/restore, can re-align every sweep to fire
# the same second; the synchronized write bursts convoy on libSQL's single writer).
# Re-rolled each firing, so no restart can ever re-align the roster.
RandomizedDelaySec=90
# First tick shortly after boot, then every 5m — the capture cadence. Persistent catches
# up a missed window (box reboot) on the next wake. The queue is idempotent + newest-first
# with per-finding backoff, so a skipped tick just defers the batch; each unit is its own
# systemd timer, never queued behind a long sweep, so the tick fires on time even while
# the whole-archive backfill drains.
OnBootSec=3min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
