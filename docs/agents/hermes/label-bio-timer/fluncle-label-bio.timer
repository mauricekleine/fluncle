[Unit]
Description=fluncle-label-bio timer — trigger the label voiced-bio authoring sweep every 30m on the rave-02 host

[Timer]
# Per-firing jitter dissolves timer-phase alignment: mass timer restarts, including a pin-watch
# rebake's quiesce/restore, can re-align every sweep to fire
# the same second; the synchronized write bursts convoy on libSQL's single writer).
# Re-rolled each firing, so no restart can ever re-align the roster.
RandomizedDelaySec=90
# First tick shortly after boot (staggered at 7min so it doesn't collide with the artist-bio
# sweep at 5min), then every 30m. A bio is one-shot-per-entity and the corpus is bounded, so
# a gentler cadence than the note sweep is right — the queue drains across a few hours, and
# the operator BACKFILL (one high-cap run) drains it in one pass. Persistent catches up a
# tick missed across a box reboot. The sweep is fill-empty-only + idempotent, so a deferred
# tick just authors on the next cycle.
OnBootSec=7min
OnUnitActiveSec=30min
Persistent=true

[Install]
WantedBy=timers.target
