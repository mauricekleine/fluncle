[Unit]
Description=fluncle-backfill timer — trigger the catalogue-backfill sweep every 30m on the rave-02 host

[Timer]
# Per-firing jitter dissolves timer-phase alignment: mass timer restarts, including a pin-watch
# rebake's quiesce/restore, can re-align every sweep to fire
# the same second; the synchronized write bursts convoy on libSQL's single writer).
# Re-rolled each firing, so no restart can ever re-align the roster.
RandomizedDelaySec=90
# First tick shortly after boot (staggered at 5min), then every 30m — the backfill cadence.
# The 30m gap lets each vendor's per-minute budget recover
# between paced batches. Persistent catches up a tick missed across a box reboot; the sweep is
# idempotent (24h base cooldown per finding), so a deferred tick just resumes the drain.
OnBootSec=5min
OnUnitActiveSec=30min
Persistent=true

[Install]
WantedBy=timers.target
