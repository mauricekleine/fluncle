[Unit]
Description=fluncle-isrc-recovery — host trigger for the free Deezer ISRC-recovery sweep
Documentation=https://github.com/mauricekleine/fluncle/blob/main/docs/agents/hermes/isrc-recovery-timer/README.md
Wants=network-online.target docker.service
After=network-online.target docker.service
# If this unit dies before writing its own /status marker (OOM, missing binary, a crash
# before the sweep catch runs), the healthcheck prober never sees a failure. This catch-all
# posts a minimal Discord alert; %n is this unit's full name.
OnFailure=fluncle-sweep-failure@%n.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/fluncle/database-admission.env
# Root drives the Docker daemon; `docker exec -u hermes` runs the WORK as the unprivileged
# hermes user. The .sh/.ts pair is BAKED at /opt/hermes-scripts/ and the sweep self-writes
# its /status marker. Deezer is tokenless; the wrapper sources the existing agent token.
ExecStart=/usr/bin/docker exec -e DATABASE_ADMISSION_FAIL_CLOSED -u hermes -e HOME=/opt/data/home -e FLUNCLE_ISRC_RECOVERY_BATCH=100 hermes bash /opt/hermes-scripts/database-admission-runner.sh fluncle-isrc-recovery -- bash /opt/hermes-scripts/isrc-recovery-sweep.sh
# This ceiling leaves a paced 100-row batch room for transport retries while remaining well
# below the hourly cadence. The sweep never calls anchor_track and therefore cannot spend Apify.
TimeoutStartSec=1330
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
