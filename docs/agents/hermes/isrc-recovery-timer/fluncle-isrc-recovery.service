[Unit]
Description=fluncle-isrc-recovery — host trigger for the free Deezer ISRC-recovery sweep
Documentation=https://github.com/mauricekleine/fluncle/blob/main/docs/agents/hermes/isrc-recovery-timer/README.md
Wants=network-online.target docker.service
After=network-online.target docker.service
# If this unit dies before writing its own /status marker (OOM, missing binary, a crash
# before the sweep catch runs), the healthcheck prober never sees a failure. This catch-all
# posts a minimal Discord alert; %n is this unit's full name.
OnFailure=fluncle-sweep-failure@%n.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/fluncle/database-admission.env
# Root drives the Docker daemon; `docker exec -u hermes` runs the WORK as the unprivileged
# hermes user. The .sh/.ts pair is BAKED at /opt/hermes-scripts/ and the sweep self-writes
# its /status marker. Deezer is tokenless; the wrapper sources the existing agent token.
# The orchestrator is deliberately NOT wrapped in a whole-lifetime admission lease: a batch's
# Deezer searches are paced at ~1.1s per row, so a single lease would hold the shared writer
# admission for minutes of third-party waiting. It opens bounded phase leases itself — one claim
# window for the worklist, then settle windows for the resolver verdicts — and every search runs
# between those phase processes with no lease at all (docs/database-performance.md).
ExecStart=/usr/bin/docker exec -e DATABASE_ADMISSION_FAIL_CLOSED -e DATABASE_ADMISSION_POLL_SECS=2 -u hermes -e HOME=/opt/data/home -e FLUNCLE_ISRC_RECOVERY_BATCH=100 hermes bash /opt/hermes-scripts/isrc-recovery-sweep.sh
# This ceiling is a BACKSTOP, not the tick's bound: the sweep's own wall budget stops its settle
# well before this, so a tick that spends its time queueing for a congested lane still writes a
# summary instead of being killed silently. The headroom covers the paced 100-row batch, its
# transport retries, and one outstanding admission wait. The sweep never calls anchor_track and
# cannot spend Apify.
TimeoutStartSec=1330
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
