[Unit]
Description=fluncle-reconcile-hub-counts — rave-02 host trigger for the nightly hub-counts reconciliation (the maintained-counter drift backstop)
Documentation=https://github.com/mauricekleine/fluncle/blob/main/docs/agents/hermes/reconcile-hub-counts-timer/README.md
Wants=network-online.target docker.service
After=network-online.target docker.service
# If this unit dies before writing its own /status marker (OOM, missing binary, a crash before the
# sweep catch runs), the healthcheck prober never sees a failure. This catch-all posts a minimal
# Discord alert; %n is this unit's full name.
OnFailure=fluncle-sweep-failure@%n.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/fluncle/database-admission.env
# Root drives the Docker daemon; `docker exec -u hermes` runs the WORK as the unprivileged hermes
# user. The .sh/.ts pair is BAKED at /opt/hermes-scripts/ (auto-updates from main via pin-watch);
# this host unit only TRIGGERS it, and the sweep self-writes its /status marker (cron-output.sh).
# The agent token comes from the shared op-injected ${HOME}/.fluncle-secrets.env the wrapper
# sources; no new secret (every statement runs Worker-side).
# Database admission is phase-scoped inside the orchestrator: each bounded reconciliation window
# takes its own short lease through database-admission-runner.sh, and nothing between windows holds
# one. The admission environment rides the `docker exec` so it reaches the runner inside the
# container. Install this unit only after the image carries the phased script (the README's
# rollout order).
ExecStart=/usr/bin/docker exec -e DATABASE_ADMISSION_FAIL_CLOSED -e DATABASE_ADMISSION_POLL_SECS=2 -u hermes -e HOME=/opt/data/home hermes bash /opt/hermes-scripts/reconcile-hub-counts.sh
# Windows start only inside a 600s budget; the last one can wait 120s for its lease, retry one
# yielded acquisition, and run a 120s request. The timeout keeps headroom past that worst case, and
# an over-long tick self-heals on the next night (the pass is idempotent).
TimeoutStartSec=1030
# Modest hardening for a root docker-driving oneshot.
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
