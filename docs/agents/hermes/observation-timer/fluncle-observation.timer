[Unit]
Description=fluncle-observation timer — trigger the recovered-audio observation sweep every 60m on the rave-02 host

[Timer]
# Per-firing jitter dissolves timer-phase alignment: mass timer restarts, including a pin-watch
# rebake's quiesce/restore, can re-align every sweep to fire
# the same second; the synchronized write bursts convoy on libSQL's single writer).
# Re-rolled each firing, so no restart can ever re-align the roster.
RandomizedDelaySec=90
# First tick shortly after boot (staggered at 4min), then every 60m — the observation cadence.
# Persistent catches up a tick missed across a box reboot.
# Batch cap 1 (each render costs Cartesia credits + subscription quota), idempotent, so a
# deferred tick just authors the next finding on the following cycle.
OnBootSec=4min
OnUnitActiveSec=60min
Persistent=true

[Install]
WantedBy=timers.target
