[Unit]
Description=fluncle-studio-clip timer — trigger the Fluncle Studio clip-cut sweep every 15m on the rave-02 host

[Timer]
# Per-firing jitter dissolves timer-phase alignment: mass timer restarts, including a pin-watch
# rebake's quiesce/restore, can re-align every sweep to fire
# the same second; the synchronized write bursts convoy on libSQL's single writer).
# Re-rolled each firing, so no restart can ever re-align the roster.
RandomizedDelaySec=90
# First tick shortly after boot (staggered at 10min), then every 15m — the studio-clip cadence.
# Persistent catches up a tick missed across a box reboot.
# Idempotent (drains `admin clips list --status pending`, cap 1/tick), so a deferred tick just
# cuts the next clip on the following cycle.
OnBootSec=10min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
