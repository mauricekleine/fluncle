[Unit]
Description=fluncle-rank — rave-02 host trigger for The Ear's catalogue-ranking sweep
Documentation=https://github.com/mauricekleine/fluncle/blob/main/docs/agents/hermes/rank-timer/README.md
Wants=network-online.target docker.service
After=network-online.target docker.service
# If this unit dies before writing its own /status marker (OOM, missing binary, a crash
# before the sweep catch runs), the healthcheck prober never sees a failure. This catch-all
# posts a minimal Discord alert; %n is this unit's full name.
OnFailure=fluncle-sweep-failure@%n.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/fluncle/database-admission.env
# Root drives the Docker daemon; `docker exec -u hermes` runs the WORK as the unprivileged
# hermes user. The .sh/.ts pair is BAKED at /opt/hermes-scripts/ (auto-updates from main via
# pin-watch); this host unit only TRIGGERS it, and the sweep self-writes its /status marker
# (cron-output.sh). NO new secret: `rank_catalogue` is AGENT tier, so the box's existing
# agent-scoped token drives it.
ExecStart=/usr/bin/docker exec -e DATABASE_ADMISSION_FAIL_CLOSED -u hermes -e HOME=/opt/data/home hermes bash /opt/hermes-scripts/database-admission-runner.sh fluncle-rank -- bash /opt/hermes-scripts/rank-sweep.sh
# A PURE trigger — zero LLM tokens. The work is SQL inside the Worker; the tick drains up to
# FLUNCLE_RANK_MAX_CALLS batches and stops, so it is bounded even right after a big crawl.
# The BUDGET is the bound, not the wall clock: a full tick is MAX_CALLS=8 × BATCH=250, and as
# the catalogue tripled over ten days each call went from a few seconds to ~60s+ — so a full
# tick is 7–9 min. Measured 2026-07-28 on rave-02: the old 300s ceiling failed 81% of ticks
# since 2026-07-26, every one of them `Result: timeout` on work that had ALREADY landed
# (`"ok":true` markers throughout). Worse, the kill only reaps the docker-exec CLIENT while
# the container-side work runs on, so /status stayed green while `systemctl --failed` showed
# red and OnFailure alerted — pure phantom red. 900s covers the measured tick with headroom
# and still sits well under the 30-min cadence, so there is no overlap risk (systemd skips an
# overlapping trigger on a oneshot rather than double-firing).
TimeoutStartSec=1030
# Modest hardening for a root docker-driving oneshot.
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
