[Unit]
Description=fluncle-healthcheck timer — trigger the /status prober every 10m on the rave-02 host

[Timer]
# Per-firing jitter dissolves timer-phase alignment: mass timer restarts, including a pin-watch
# rebake's quiesce/restore, can re-align every sweep to fire
# the same second; the synchronized write bursts convoy on libSQL's single writer).
# Re-rolled each firing, so no restart can ever re-align the roster.
RandomizedDelaySec=90
# First tick shortly after boot, then every 10m — the prober's cadence.
# Persistent catches up a missed window (box reboot) on the next wake. A tick is a
# cheap ~5s probe, so 10m is free; each unit is its own systemd timer, never queued
# behind a long sweep, so the tick always fires on time.
OnBootSec=2min
OnUnitActiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target
