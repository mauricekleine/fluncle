[Unit]
Description=fluncle-device-mirror — host trigger for the atomic shared device-replica publisher
Documentation=https://github.com/mauricekleine/fluncle/blob/main/docs/agents/hermes/device-mirror-timer/README.md
Wants=network-online.target docker.service
After=network-online.target docker.service
# If this unit dies before writing its own /status marker, the healthcheck prober never sees a
# failure. This catch-all posts the fleet's minimal failure alert; %n is this unit's full name.
OnFailure=fluncle-sweep-failure@%n.service

[Service]
Type=oneshot
# Root drives Docker; the unprivileged hermes user runs the baked wrapper and reads the shared
# 0600 secrets file. That file supplies read-only source credentials and write-scoped target
# credentials. The script keeps its embedded replica/generation under HOME and self-writes its
# ledger/status marker; the target's live mutation is one transaction after staged validation.
ExecStart=/usr/bin/docker exec -u hermes -e HOME=/opt/data/home hermes bash /opt/hermes-scripts/device-mirror.sh
# One embedded-replica sync, a local derivation, bounded staging upload, and one target cutover.
# Keep the ceiling below the hourly cadence; the script's own atomic lock is the second guard.
TimeoutStartSec=3300
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
