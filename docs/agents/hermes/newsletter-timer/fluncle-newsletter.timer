[Unit]
Description=fluncle-newsletter timer — draft the weekly edition Fri 15:00 Amsterdam on the rave-02 host

[Timer]
# Per-firing jitter dissolves timer-phase alignment: mass timer restarts, including a pin-watch
# rebake's quiesce/restore, can re-align every sweep to fire
# the same second; the synchronized write bursts convoy on libSQL's single writer).
# Re-rolled each firing, so no restart can ever re-align the roster.
RandomizedDelaySec=60
# The weekly Friday 15:00 Amsterdam edition. The systemd timer expresses the timezone DIRECTLY
# in OnCalendar, so the slot is correct regardless of the host or container TZ. Persistent catches up a Friday the box slept through on the next boot —
# harmless, because the sweep only PERSISTS a draft (the Send is a separate operator-gated
# command), so a late draft never auto-sends.
OnCalendar=Fri 15:00 Europe/Amsterdam
OnCalendar=Fri 16:15 Europe/Amsterdam
Persistent=true

[Install]
WantedBy=timers.target
