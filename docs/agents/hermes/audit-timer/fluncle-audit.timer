[Unit]
Description=fluncle-audit timer — the nightly codebase-audit auditor at 01:00 Amsterdam on the rave-02 host

[Timer]
# Per-firing jitter dissolves timer-phase alignment: mass timer restarts, including a pin-watch
# rebake's quiesce/restore, can re-align every sweep to fire
# the same second; the synchronized write bursts convoy on libSQL's single writer).
# Re-rolled each firing, so no restart can ever re-align the roster.
RandomizedDelaySec=60
# 01:00 Europe/Amsterdam via the explicit OnCalendar TZ suffix — the host clock is UTC (only the
# Hermes container is TZ-pinned), so we name the zone here; DST-safe, needs systemd >=252. One
# domain per night on a 7-day rotation (audit/rotation.ts). The 5am reviewer (fluncle-audit-review)
# reviews + merges the PR this opens. Persistent catches up a tick missed across a box reboot;
# a late audit is harmless (it just opens tonight's PR whenever it runs).
OnCalendar=*-*-* 01:00:00 Europe/Amsterdam
Persistent=true

[Install]
WantedBy=timers.target
