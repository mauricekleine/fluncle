[Unit]
Description=fluncle-audit — nightly codebase auditor (one domain/night; opens a PR the 5am reviewer merges)
Documentation=https://github.com/mauricekleine/fluncle/blob/main/docs/agents/hermes/audit-timer/README.md
Wants=network-online.target docker.service
After=network-online.target docker.service
# If this unit dies before writing its own /status marker (OOM, missing binary, a crash
# before the sweep catch runs), the healthcheck prober never sees a failure. This catch-all
# posts a minimal Discord alert; %n is this unit's full name.
OnFailure=fluncle-sweep-failure@%n.service

[Service]
Type=oneshot
# Root drives the Docker daemon; `docker exec -u hermes` runs the WORK as the unprivileged
# hermes user. The .sh + the audit/ tree are BAKED at /opt/hermes-scripts (Unit A — auto-updates
# from main via pin-watch); this host unit only TRIGGERS the sweep, which self-writes its /status
# marker (cron-output.sh).
ExecStart=/usr/bin/docker exec -u hermes -e HOME=/opt/data/home hermes bash /opt/hermes-scripts/audit-sweep.sh
# A BACKSTOP, NOT THE BUDGET. This timeout kills the host-side `docker exec` client only — the
# container-side sweep keeps running, finishes later, and writes its ordinary marker and ledger
# row, so a unit that reads `Result=timeout` here can still read `ok:true` in the ledger. The real
# budget therefore lives in the script (`agent-pass.sh`, AGENT_PASS_BUDGET_SECS), which always
# exits on its own terms and always writes an honest summary. This value must stay ABOVE
# that budget plus the driver's clone/install/ship time, or the host kill races the script again:
#
#     AGENT_PASS_BUDGET_SECS (4800) + kill grace (60) + setup/ship headroom  <  5400
TimeoutStartSec=5400
# Modest hardening for a root docker-driving oneshot.
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
