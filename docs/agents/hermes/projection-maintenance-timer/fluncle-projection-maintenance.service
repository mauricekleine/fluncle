[Unit]
Description=fluncle-projection-maintenance — bounded public projection repair after cutover
Documentation=https://github.com/mauricekleine/fluncle/blob/main/docs/agents/hermes/projection-maintenance-timer/README.md
Wants=network-online.target docker.service
After=network-online.target docker.service
OnFailure=fluncle-sweep-failure@%n.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/fluncle/database-admission.env
ExecStart=/usr/bin/docker exec -e DATABASE_ADMISSION_FAIL_CLOSED -u hermes -e HOME=/opt/data/home hermes bash /opt/hermes-scripts/database-admission-runner.sh fluncle-projection-maintenance -- bash /opt/hermes-scripts/projection-maintenance-sweep.sh
# Admission may wait for 120s. The payload then has one status read and at most eight bounded
# repair requests (four per family); the next timer firing resumes any honest incomplete result.
TimeoutStartSec=610
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
