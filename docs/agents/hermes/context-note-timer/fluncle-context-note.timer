[Unit]
Description=fluncle-context-note timer — trigger the context-note sweep every 5m on the rave-02 host

[Timer]
# Per-firing jitter dissolves timer-phase alignment: mass timer restarts, including a pin-watch
# rebake's quiesce/restore, can re-align every sweep to fire
# the same second; the synchronized write bursts convoy on libSQL's single writer).
# Re-rolled each firing, so no restart can ever re-align the roster.
RandomizedDelaySec=90
# First tick shortly after boot (staggered at 2min so the simultaneous 5-min sweeps don't
# pile), then every 5m — the context-note cadence. Persistent
# catches up a tick missed across a box reboot. Idempotent (hasContext=false queue), so a
# deferred tick just fills context on the next cycle.
OnBootSec=2min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
